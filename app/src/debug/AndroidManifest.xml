<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application>
        <receiver
            android:name="com.bg7yoz.ft8cn.diagnostics.SampleDecodeReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.bg7yoz.ft8cn.ft4.DEBUG_DECODE_SAMPLE" />
                <action android:name="com.bg7yoz.ft8cn.action.DEBUG_SAMPLE_DECODE" />
            </intent-filter>
        </receiver>

        <service
            android:name="com.bg7yoz.ft8cn.diagnostics.SampleDecodeForegroundService"
            android:enabled="true"
            android:exported="false" />
    </application>
</manifest>
