<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <padding
        android:bottom="6dp"
        android:left="8dp"
        android:right="8dp"
        android:top="6dp" />

    <stroke
        android:width="1dp"
        android:color="@color/calling_list_item_color" />

    <gradient
        android:angle="270"
        android:startColor="@color/calling_list_start_color"
        android:endColor="@color/calling_list_end_color"
        android:type="linear" />

    <corners android:radius="18dp" />
</shape>
