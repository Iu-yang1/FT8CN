<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_press_solid_color" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <stroke
                android:width="0dp"
                android:color="@color/button_disable_strocke_color" />
            <gradient
                android:angle="0"
                android:startColor="@color/button_start_color"
                android:endColor="@color/button_end_color"
                android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/button_stroke_color" />
            <gradient
                android:angle="0"
                android:startColor="@color/button_start_color"
                android:endColor="@color/button_end_color"
                android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
